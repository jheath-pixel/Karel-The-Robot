{
    "name": "Becker Karel Classroom",

    "build": {
        "dockerfile": "../Dockerfile"
    },
    "overrideCommand": false,

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack"
            ]
        }
    },

    "forwardPorts": [
        6080
    ],

    "portsAttributes": {
        "6080": {
            "label": "Karel Display",
            "onAutoForward": "openBrowser"
        }
    },

    "remoteUser": "vscode",
    "containerEnv": {
    "DISPLAY": ":1"
    },
    "postStartCommand": "bash scripts/start-display.sh > /tmp/karel-display.log 2>&1 &"
}