{
    "name": "Becker Karel Classroom",

    "build": {
        "dockerfile": "../Dockerfile"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack"
            ]
        }
    },

    "forwardPorts": [
        6080
    ],

    "portsAttributes": {
        "6080": {
            "label": "Karel Display",
            "onAutoForward": "openBrowser"
        }
    },

    "remoteUser": "vscode"
}