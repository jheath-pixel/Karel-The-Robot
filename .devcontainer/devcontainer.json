{
    "name": "Becker Karel Classroom",

    "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",

    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {}
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack"
            ]
        }
    },

    "forwardPorts": [
        6080
    ],

    "portsAttributes": {
        "6080": {
            "label": "Karel Display",
            "onAutoForward": "openBrowser"
        }
    }
}
